rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// Nesty – Firestore Security Rules
// Covers: bookings, notifications, users, properties, conversations, messages
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ────────────────────────────────────────────────────

    /// True if the request comes from a signed-in user.
    function isAuth() {
      return request.auth != null;
    }

    /// True if the calling user's UID matches [uid].
    function isUser(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    /// True if the incoming document field [field] equals [uid].
    function ownsField(field, uid) {
      return request.resource.data[field] == uid;
    }

    /// Validates a booking write:
    ///  - guestId must be the caller
    ///  - required fields must be present
    ///  - price must be positive
    function isValidBooking() {
      let d = request.resource.data;
      return ownsField('guestId', request.auth.uid)
          && d.keys().hasAll(['propertyId', 'property', 'checkInDate',
                              'checkOutDate', 'totalPrice', 'status',
                              'totalGuests', 'guestId', 'hostId',
                              'paymentMethod', 'termsAccepted', 'createdAt'])
          && d.totalPrice > 0
          && d.totalGuests >= 1
          && d.termsAccepted == true;
    }

    // ── bookings ─────────────────────────────────────────────────────────────
    match /bookings/{bookingId} {
      // Guest can read their own bookings; host can read bookings for their props.
      allow read: if isAuth()
          && (resource.data.guestId == request.auth.uid
              || resource.data.hostId == request.auth.uid);

      // Only a valid, authenticated guest can create a booking.
      allow create: if isAuth() && isValidBooking();

      // Guests may cancel (set status=cancelled) their own pending booking.
      // Hosts may update status to upcoming/cancelled/current.
      allow update: if isAuth()
          && (
            // Guest cancels their own booking
            (resource.data.guestId == request.auth.uid
             && request.resource.data.status == 'cancelled'
             && resource.data.status == 'pending')
            ||
            // Host changes status
            (resource.data.hostId == request.auth.uid
             && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status']))
          );

      // No hard deletes allowed – cancelled status is the tombstone.
      allow delete: if false;
    }

    // ── notifications ─────────────────────────────────────────────────────────
    match /notifications/{notifId} {
      // Users can only read their own notifications.
      allow read: if isAuth() && resource.data.userId == request.auth.uid;

      // Backend (service account) writes; clients only mark as read.
      allow create: if isAuth();
      allow update: if isAuth()
          && resource.data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['isRead']);
      allow delete: if false;
    }

    // ── users ─────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read:   if isAuth();
      allow create: if isUser(userId);
      allow update: if isUser(userId);
      allow delete: if false;
    }

    // ── properties ────────────────────────────────────────────────────────────
    match /properties/{propertyId} {
      allow read:   if true; // Public listing
      allow create: if isAuth() && ownsField('hostId', request.auth.uid);
      allow update: if isAuth() && resource.data.hostId == request.auth.uid;
      allow delete: if isAuth() && resource.data.hostId == request.auth.uid;
    }

    // ── conversations / messages ──────────────────────────────────────────────
    match /conversations/{conversationId} {
      allow read, write: if isAuth()
          && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read: if isAuth()
            && request.auth.uid in
               get(/databases/$(database)/documents/conversations/$(conversationId))
               .data.participants;
        allow create: if isAuth()
            && request.auth.uid in
               get(/databases/$(database)/documents/conversations/$(conversationId))
               .data.participants;
        allow update, delete: if false;
      }
    }
  }
}
